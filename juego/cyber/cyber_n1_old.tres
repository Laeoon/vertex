[resource]
script = ExtResource("1_graph")
nodes = Array[Resource]([SubResource("Node_Internet"), SubResource("Node_FirewallPer"), SubResource("Node_DMZ"), SubResource("Node_InternalFW"), SubResource("Node_ServInterno"), SubResource("Node_Database"), SubResource("Node_Proxy"), SubResource("Node_MailServer"), SubResource("Node_IDS"), SubResource("Node_Monitor")])
edges = Array[Resource]([SubResource("Edge_Internet_FWPer"), SubResource("Edge_Internet_Proxy"), SubResource("Edge_FWPer_DMZ"), SubResource("Edge_DMZ_InternalFW"), SubResource("Edge_InternalFW_ServInterno"), SubResource("Edge_ServInterno_Database"), SubResource("Edge_Proxy_MailServer"), SubResource("Edge_MailServer_InternalFW"), SubResource("Edge_Internet_IDS"), SubResource("Edge_IDS_Monitor"), SubResource("Edge_Monitor_Database")])
directed = true
