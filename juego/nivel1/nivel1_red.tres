[resource]
script = ExtResource("1_graph")
nodes = Array[Resource]([SubResource("Node_Inicio"), SubResource("Node_Puerta"), SubResource("Node_RPA"), SubResource("Node_Seguridad"), SubResource("Node_CPD"), SubResource("Node_Cajas"), SubResource("Node_Sala"), SubResource("Node_Boveda")])
edges = Array[Resource]([SubResource("Edge_Inicio_Puerta"), SubResource("Edge_Inicio_RPA"), SubResource("Edge_Puerta_Seguridad"), SubResource("Edge_RPA_Seguridad"), SubResource("Edge_Seguridad_CPD"), SubResource("Edge_Seguridad_Cajas"), SubResource("Edge_CPD_Sala"), SubResource("Edge_Cajas_Sala"), SubResource("Edge_Sala_Boveda"), SubResource("Edge_Cajas_Boveda")])
directed = true
