mitigation_capacity = 2.0
protocol = &"HTTPS"

[sub_resource type="Resource" id="Edge_Backup_DC"]
script = ExtResource("3_edge")
from_id = &"BackupRoute"
to_id = &"DataCenter"
transit_cost = 5.0
mitigation_capacity = 2.0
protocol = &"HTTPS"

[resource]
script = ExtResource("1_graph")
nodes = Array[Resource]([SubResource("Node_Internet"), SubResource("Node_FirewallExt"), SubResource("Node_DMZ"), SubResource("Node_FirewallInt"), SubResource("Node_DataCenter"), SubResource("Node_Proxy"), SubResource("Node_BackupRoute")])
edges = Array[Resource]([SubResource("Edge_Internet_FWExt"), SubResource("Edge_Internet_Proxy"), SubResource("Edge_FWExt_DMZ"), SubResource("Edge_Proxy_DMZ"), SubResource("Edge_DMZ_FWInt"), SubResource("Edge_DMZ_Backup"), SubResource("Edge_FWInt_DC"), SubResource("Edge_Backup_DC")])
directed = true
