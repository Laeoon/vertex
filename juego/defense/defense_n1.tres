[gd_resource type="Resource" script_class="NetworkGraphResource" load_steps=16 format=3]

[ext_resource type="Script" path="res://core/network/network_graph_resource.gd" id="1_graph"]
[ext_resource type="Script" path="res://core/network/network_node_resource.gd" id="2_node"]
[ext_resource type="Script" path="res://core/network/network_edge_resource.gd" id="3_edge"]

[sub_resource type="Resource" id="Node_Internet"]
script = ExtResource("2_node")
id = &"Internet"
display_name = "Internet"
node_type = 1
initial_state = &"disponible"
position = Vector2(60, 300)
metadata = {
"detection_chance": 0.0,
"label": "Origen del ataque"
}

[sub_resource type="Resource" id="Node_FirewallExt"]
script = ExtResource("2_node")
id = &"FirewallExt"
display_name = "FW Externo"
node_type = 2
initial_state = &"disponible"
position = Vector2(220, 150)
metadata = {
"detection_chance": 0.0,
"has_firewall": true,
"label": "Primera línea"
}

[sub_resource type="Resource" id="Node_DMZ"]
script = ExtResource("2_node")
id = &"DMZ"
