}

[sub_resource type="Resource" id="Node_BackupRoute"]
script = ExtResource("2_node")
id = &"BackupRoute"
display_name = "Ruta Backup"
node_type = 2
initial_state = &"disponible"
position = Vector2(420, 450)
metadata = {
"detection_chance": 0.0,
"label": "Enlace secundario"
}

[sub_resource type="Resource" id="Edge_Internet_FWExt"]
script = ExtResource("3_edge")
from_id = &"Internet"
to_id = &"FirewallExt"
transit_cost = 1.0
mitigation_capacity = 3.0
protocol = &"EXTERNAL"

[sub_resource type="Resource" id="Edge_Internet_Proxy"]
script = ExtResource("3_edge")
from_id = &"Internet"
to_id = &"Proxy"
transit_cost = 2.0
mitigation_capacity = 3.0
protocol = &"EXTERNAL"

[sub_resource type="Resource" id="Edge_FWExt_DMZ"]
script = ExtResource("3_edge")
from_id = &"FirewallExt"
to_id = &"DMZ"
transit_cost = 2.0
mitigation_capacity = 2.0
protocol = &"INTERNAL"

[sub_resource type="Resource" id="Edge_Proxy_DMZ"]
script = ExtResource("3_edge")
from_id = &"Proxy"
to_id = &"DMZ"
transit_cost = 3.0
mitigation_capacity = 2.0
protocol = &"HTTPS"

[sub_resource type="Resource" id="Edge_DMZ_FWInt"]
script = ExtResource("3_edge")
from_id = &"DMZ"
to_id = &"FirewallInt"
transit_cost = 2.0
mitigation_capacity = 2.0
protocol = &"INTERNAL"

[sub_resource type="Resource" id="Edge_DMZ_Backup"]
script = ExtResource("3_edge")
from_id = &"DMZ"
to_id = &"BackupRoute"
