; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Simulador de Ciberseguridad Basado en Teoría de Grafos"
run/main_scene="res://escenas/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameLogger="*res://core/autoloads/logger.gd"
Events="*res://core/autoloads/events.gd"
SceneParams="*res://core/autoloads/scene_params.gd"
LocaleManager="*res://core/locale/locale_manager.tscn"
SceneTransition="*res://core/autoloads/scene_transition.gd"
AudioManager="*res://core/autoloads/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode="exclusive_fullscreen"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
